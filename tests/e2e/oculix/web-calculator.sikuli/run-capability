#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'oculix web-calculator: %s\n' "$1" >&2
  exit "${2:-1}"
}

record_diagnostic() {
  local name="$1"
  local message="$2"

  mkdir -p "$diagnostics_directory"
  printf '%s\n' "$message" >"$diagnostics_directory/$name"
}

stop_browser() {
  local stop_failed=0

  if [[ -z "$browser_pid" ]]; then
    return
  fi

  if ! kill -0 "$browser_pid" 2>/dev/null; then
    wait "$browser_pid" 2>/dev/null || :
    return
  fi
  if ! kill -TERM "$browser_pid" 2>/dev/null &&
    kill -0 "$browser_pid" 2>/dev/null; then
    stop_failed=1
  fi
  for _ in {1..50}; do
    if ! kill -0 "$browser_pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if kill -0 "$browser_pid" 2>/dev/null; then
    if ! kill -KILL "$browser_pid" 2>/dev/null; then
      stop_failed=1
    fi
  fi
  wait "$browser_pid" 2>/dev/null || :

  if [[ "$stop_failed" -ne 0 ]]; then
    cleanup_failed=1
    record_diagnostic \
      "cleanup-error.txt" \
      "Failed to terminate the Chromium process $browser_pid."
  fi
}

cleanup_session() {
  local status=$?

  trap - EXIT INT TERM
  stop_browser
  if [[ "$owns_session_directory" -eq 1 ]]; then
    rm -rf -- "$session_directory"
  fi

  if [[ "$status" -eq 0 && "$cleanup_failed" -ne 0 ]]; then
    status=1
  fi
  exit "$status"
}

[[ "$#" -eq 2 ]] || fail "expected OS and browser capability inputs." 2
selected_os="$1"
selected_browser="$2"
capability="$selected_os-$selected_browser"
[[ "$capability" == "ubuntu-chromium" ]] ||
  fail "unsupported capability '$capability'; supported: ubuntu-chromium." 2

cd "${MISE_PROJECT_ROOT:?MISE_PROJECT_ROOT is required}"
: "${WEB_CALCULATOR_URL:?WEB_CALCULATOR_URL is required}"

diagnostics_directory="${OCULIX_WEB_CALCULATOR_DIAGNOSTICS:-$MISE_PROJECT_ROOT/oculix-web-calculator-diagnostics}"
session_root="${RUNNER_TEMP:-${TMPDIR:-/tmp}}"
if [[ -n "${OCULIX_WEB_CALCULATOR_SESSION_DIRECTORY:-}" ]]; then
  session_directory="$OCULIX_WEB_CALCULATOR_SESSION_DIRECTORY"
  owns_session_directory=0
else
  session_directory="$(mktemp -d "$session_root/oculix-web-calculator.XXXXXX")"
  owns_session_directory=1
fi
user_data_directory="$session_directory/chromium-profile"
browser_log="$diagnostics_directory/chromium.log"
readiness_file="$user_data_directory/DevToolsActivePort"
browser_binary=""
browser_pid=""
cleanup_failed=0
mkdir -p "$user_data_directory"
trap cleanup_session EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for candidate in chromium chromium-browser; do
  if command -v "$candidate" >/dev/null 2>&1; then
    browser_binary="$(command -v "$candidate")"
    break
  fi
done

browser_version="unavailable"
if [[ -n "$browser_binary" ]]; then
  browser_version="$("$browser_binary" --version 2>&1 | head -n 1 || :)"
fi
host_description="$(
  sed -n 's/^PRETTY_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release |
    head -n 1
)"
{
  printf 'capability=%s\n' "$capability"
  printf 'browser_binary=%s\n' "$browser_binary"
  printf 'browser_version=%s\n' "${browser_version:-unknown}"
  printf 'host=%s\n' "${host_description:-unknown}"
  printf 'uname=%s\n' "$(uname -a)"
  printf 'runner_os=%s\n' "${RUNNER_OS:-unavailable}"
  printf 'runner_arch=%s\n' "${RUNNER_ARCH:-unavailable}"
  printf 'image_os=%s\n' "${ImageOS:-unavailable}"
  printf 'image_version=%s\n' "${ImageVersion:-unavailable}"
} | tee "$diagnostics_directory/environment.txt"

if [[ -z "$browser_binary" ]]; then
  record_diagnostic \
    "browser-launch-error.txt" \
    "Chromium was not found as either 'chromium' or 'chromium-browser'."
  fail "Chromium is required for capability ubuntu-chromium."
fi

"$browser_binary" \
  --app="$WEB_CALCULATOR_URL" \
  --disable-background-networking \
  --disable-component-update \
  --disable-default-apps \
  --disable-extensions \
  --disable-gpu \
  --disable-sync \
  --force-device-scale-factor=1 \
  --no-default-browser-check \
  --no-first-run \
  --ozone-platform=x11 \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=0 \
  --user-data-dir="$user_data_directory" \
  --window-position=0,0 \
  --window-size=1280,1024 \
  >"$browser_log" 2>&1 &
browser_pid=$!

for _ in {1..100}; do
  if [[ -s "$readiness_file" ]]; then
    break
  fi
  if ! kill -0 "$browser_pid" 2>/dev/null; then
    record_diagnostic \
      "browser-launch-error.txt" \
      "Chromium exited before its DevTools endpoint became ready."
    fail "Chromium exited during launch; see diagnostics."
  fi
  sleep 0.1
done
if [[ ! -s "$readiness_file" ]]; then
  record_diagnostic \
    "browser-launch-error.txt" \
    "Chromium did not become ready within 10 seconds."
  fail "Chromium timed out during launch; see diagnostics."
fi

export E2E_OS="$selected_os"
export E2E_BROWSER="$selected_browser"
export OCULIX_WEB_CALCULATOR_CAPABILITY="$capability"
export OCULIX_WEB_CALCULATOR_DIAGNOSTICS="$diagnostics_directory"
mise run oculix:run tests/e2e/oculix/web-calculator.sikuli
