#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)

case "$(uname -s)" in
  CYGWIN* | MINGW* | MSYS*)
    repository_root_windows=$(cygpath -w "$repository_root")
    commit_message_windows=$(cygpath -w "$1")
    export OCULIX_MISE="$repository_root_windows\\bin\\mise.cmd"
    export OCULIX_COMMIT_MESSAGE="$commit_message_windows"
    # PowerShell, not this POSIX shell, expands the environment variables.
    # shellcheck disable=SC2016
    exec powershell.exe -NoLogo -NoProfile -NonInteractive -Command \
      '& $env:OCULIX_MISE exec -- hk run commit-msg --from-hook $env:OCULIX_COMMIT_MESSAGE'
    ;;
  *)
    exec "$repository_root/bin/mise" exec -- hk run commit-msg --from-hook "$@"
    ;;
esac
