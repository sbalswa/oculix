#!/usr/bin/env bash

set -Eeuo pipefail

readonly repository="${GITHUB_REPOSITORY:-}"
readonly branch_prefix="automation/toolchain/"
readonly maintenance_issue_title="Toolchain maintenance needs triage"
readonly jdk_drift_issue_title="Oculix JDK major drift detected"
readonly minimum_age_days="${TOOLCHAIN_MIN_AGE_DAYS:-7}"
readonly dry_run="${TOOLCHAIN_DRY_RUN:-false}"
readonly mise_config_path="mise/config.toml"
readonly mise_lock_path="mise/mise.lock"
readonly oculix_config_path="mise/config.oculix.toml"
readonly oculix_lock_path="mise/mise.oculix.lock"
readonly oculix_release_repository="oculix-org/Oculix"
readonly oculix_lock_platforms="linux-x64,linux-arm64,macos-arm64,windows-x64"

default_branch=""
created_pr=""
tool_updates=""
extras_oculix_summary=""
extras_oculix_candidate=""
extras_java_candidate=""
oculix_ci_default_branch=""
oculix_ci_commit_sha=""
oculix_ci_declarations=""
oculix_ci_ignored=""

set_output() {
  local name="$1"
  local value="$2"

  if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    printf '%s=%s\n' "$name" "$value" >>"$GITHUB_OUTPUT"
  else
    printf '%s=%s\n' "$name" "$value"
  fi
}

version_is_greater() {
  local candidate="$1"
  local current="$2"

  [[ "$candidate" != "$current" ]] &&
    [[ "$(printf '%s\n%s\n' "$candidate" "$current" | sort -V | tail -n 1)" == "$candidate" ]]
}

find_warnings() {
  awk '
    {
      normalized = tolower($0)
      gsub(/(^|[^[:digit:]])0 warnings?([^[:alnum:]_]|$)/, "", normalized)
      if (normalized ~ /::warning::|(^|[^[:alnum:]_])warnings?([^[:alnum:]_]|$)/) {
        print
      }
    }
  '
}

latest_eligible_release() {
  local release_repository="$1"
  local current="$2"
  local cutoff releases best="" tag published version published_epoch

  cutoff="$(date -u -d "${minimum_age_days} days ago" +%s)"
  if ! releases="$(
    # The newest 100 releases are an intentional bounded update window.
    gh api \
      --method GET \
      "repos/${release_repository}/releases" \
      -f per_page=100 \
      --jq '.[] |
        select(
          .draft == false and
          .prerelease == false and
          .published_at != null
        ) |
        [.tag_name, .published_at] |
        @tsv'
  )"; then
    printf 'Failed to read releases for %s.\n' "$release_repository" >&2
    return 1
  fi
  if [[ -z "$releases" ]]; then
    return
  fi

  while IFS=$'\t' read -r tag published; do
    version="${tag#v}"
    if [[ ! "$version" =~ ^[0-9]+([.][0-9]+){1,3}$ ]]; then
      continue
    fi

    published_epoch="$(date -u -d "$published" +%s)"
    if ((published_epoch > cutoff)) || ! version_is_greater "$version" "$current"; then
      continue
    fi
    if [[ -z "$best" ]] || version_is_greater "$version" "$best"; then
      best="$version"
    fi
  done <<<"$releases"

  printf '%s' "$best"
}

current_mise_version() {
  local version

  version="$(
    sed -n 's/^min_version = "\([^"]*\)"$/\1/p' "${mise_config_path}"
  )"
  if [[ ! "$version" =~ ^[0-9]+([.][0-9]+){2,3}$ ]]; then
    printf '%s must contain one numeric min_version.\n' "${mise_config_path}" >&2
    return 1
  fi
  printf '%s' "$version"
}

assert_mise_version() {
  local expected actual

  expected="$(current_mise_version)"
  actual="$(mise --version | awk '{ print $1 }')"
  if [[ "$actual" != "$expected" ]]; then
    printf 'Running mise %s does not match the checked-in pin %s.\n' \
      "$actual" "$expected" >&2
    return 1
  fi
}

backend_repository() {
  local backend="$1"

  case "$backend" in
    aqua:* | github:*)
      printf '%s' "${backend#*:}"
      ;;
    packslip:github.com/*)
      printf '%s' "${backend#packslip:github.com/}"
      ;;
    *)
      printf 'Unsupported mise backend: %s\n' "$backend" >&2
      return 1
      ;;
  esac
}

project_tools() {
  local config_path

  config_path="$(realpath "${mise_config_path}")"
  mise config ls --json |
    jq -r --arg path "$config_path" \
      '.[] | select(.path == $path) | .tools[]'
}

current_tool_version() {
  local tool="$1"
  local config_path

  config_path="$(realpath "${mise_config_path}")"
  mise ls --current --json |
    jq -r \
      --arg tool "$tool" \
      --arg path "$config_path" \
      '.[$tool][] |
        select(.source.path == $path) |
        .requested_version'
}

collect_tool_updates() {
  local tools tool current backend release_repository candidate

  tool_updates=""
  if ! tools="$(project_tools)"; then
    printf 'Failed to read repository tools from %s.\n' "${mise_config_path}" >&2
    return 1
  fi
  if [[ -z "$tools" ]]; then
    printf 'No repository tools were found in %s.\n' "${mise_config_path}" >&2
    return 1
  fi

  while IFS= read -r tool; do
    backend="$(mise tool "$tool" --backend)"
    case "$backend" in
      core:* | http:*)
        # Version-pinned runtimes/artifacts (Java, the Oculix jar) have no
        # upstream release feed to track, so skip rather than fail.
        printf 'Skipping %s: backend %s is version-pinned, not release-tracked.\n' \
          "$tool" "$backend" >&2
        continue
        ;;
    esac
    current="$(current_tool_version "$tool")"
    release_repository="$(backend_repository "$backend")"
    candidate="$(latest_eligible_release "$release_repository" "$current")"
    if [[ -n "$candidate" ]]; then
      tool_updates+="${tool}"$'\t'"${current}"$'\t'"${candidate}"$'\n'
    fi
  done <<<"$tools"
  tool_updates="${tool_updates%$'\n'}"
}

checkout_base() {
  local branch="$1"

  git fetch origin \
    "refs/heads/${branch}:refs/remotes/origin/${branch}"
  git switch --detach "refs/remotes/origin/${branch}"
}

remote_branch_sha() {
  local branch="$1"
  local output

  if ! output="$(
    git ls-remote --heads origin "refs/heads/${branch}"
  )"; then
    printf 'Failed to inspect remote branch %s.\n' "$branch" >&2
    return 1
  fi
  awk '{ print $1 }' <<<"$output"
}

verify_expected_branch() {
  local branch="$1"
  local base_sha="$2"
  local expected_diff="$3"
  local remote_ref remote_sha parents commit parent extra remote_diff

  remote_ref="refs/remotes/origin/${branch}"
  git fetch origin "refs/heads/${branch}:${remote_ref}"
  remote_sha="$(git rev-parse "${remote_ref}^{commit}")"
  parents="$(git rev-list --parents -n 1 "$remote_sha")"
  read -r commit parent extra <<<"$parents"
  if [[ "$commit" != "$remote_sha" ||
        "$parent" != "$base_sha" ||
        -n "$extra" ]]; then
    printf 'Remote branch %s does not have the expected parent %s.\n' \
      "$branch" "$base_sha" >&2
    return 1
  fi

  remote_diff="$(git diff --binary "$base_sha" "$remote_sha")"
  if [[ "$remote_diff" != "$expected_diff" ]]; then
    printf 'Remote branch %s does not contain the expected update.\n' \
      "$branch" >&2
    return 1
  fi
  verify_github_commit "$remote_sha"
  printf '%s' "$remote_sha"
}

verify_github_commit() {
  local sha="$1"
  local attempt data verified reason author

  for attempt in {1..5}; do
    if data="$(
      gh api \
        --method GET \
        "repos/${repository}/commits/${sha}"
    )"; then
      verified="$(
        jq -r '.commit.verification.verified' <<<"$data"
      )"
      reason="$(
        jq -r '.commit.verification.reason' <<<"$data"
      )"
      author="$(
        jq -r '.author.login // empty' <<<"$data"
      )"
      if [[ "$verified" == "true" &&
            "$author" == "github-actions[bot]" ]]; then
        return
      fi
    fi
    if ((attempt < 5)); then
      sleep 1
    fi
  done

  printf 'Commit %s must be authored by github-actions[bot] and verified; author=%s verification=%s (%s).\n' \
    "$sha" "${author:-unknown}" "${verified:-unknown}" "${reason:-unknown}" >&2
  return 1
}

create_github_commit() {
  local branch="$1"
  local base_sha="$2"
  local expected_diff="$3"
  local headline="$4"
  shift 4

  local additions="[]" deletions="[]" path contents existing_sha
  local query payload response commit_sha errors

  for path in "$@"; do
    if [[ -f "$path" ]]; then
      contents="$(base64 <"$path" | tr -d '\n')"
      additions="$(
        jq -c \
          --arg path "$path" \
          --arg contents "$contents" \
          '. + [{path: $path, contents: $contents}]' \
          <<<"$additions"
      )"
    elif git cat-file -e "${base_sha}:${path}" 2>/dev/null; then
      deletions="$(
        jq -c \
          --arg path "$path" \
          '. + [{path: $path}]' \
          <<<"$deletions"
      )"
    else
      printf 'Cannot commit missing path %s.\n' "$path" >&2
      return 1
    fi
  done

  if [[ "$dry_run" == "true" ]]; then
    printf 'Would create a GitHub-signed commit on %s: %s\n' \
      "$branch" "$headline" >&2
    printf '%s' "$base_sha"
    return
  fi

  existing_sha="$(remote_branch_sha "$branch")"
  if [[ -z "$existing_sha" ]]; then
    gh api \
      --silent \
      --method POST \
      "repos/${repository}/git/refs" \
      -f ref="refs/heads/${branch}" \
      -f sha="$base_sha"
  elif [[ "$existing_sha" != "$base_sha" ]]; then
    printf 'Remote branch %s moved before its commit was created.\n' \
      "$branch" >&2
    return 1
  fi

  # $input is GraphQL syntax and must reach GitHub literally; it is not a shell variable.
  # shellcheck disable=SC2016
  query='
    mutation CreateAutomationCommit($input: CreateCommitOnBranchInput!) {
      createCommitOnBranch(input: $input) {
        commit {
          oid
        }
      }
    }
  '
  payload="$(
    jq -n \
      --arg query "$query" \
      --arg repository "$repository" \
      --arg branch "$branch" \
      --arg expected_head_oid "$base_sha" \
      --arg headline "$headline" \
      --argjson additions "$additions" \
      --argjson deletions "$deletions" \
      '{
        query: $query,
        variables: {
          input: {
            branch: {
              repositoryNameWithOwner: $repository,
              branchName: $branch
            },
            expectedHeadOid: $expected_head_oid,
            message: {
              headline: $headline
            },
            fileChanges: {
              additions: $additions,
              deletions: $deletions
            }
          }
        }
      }'
  )"
  response="$(
    gh api graphql --input - <<<"$payload"
  )"
  errors="$(jq -r '.errors // empty' <<<"$response")"
  commit_sha="$(
    jq -r '.data.createCommitOnBranch.commit.oid // empty' <<<"$response"
  )"
  if [[ -n "$errors" || -z "$commit_sha" ]]; then
    printf 'Failed to create GitHub-signed commit on %s:\n%s\n' \
      "$branch" "$response" >&2
    return 1
  fi

  existing_sha="$(
    verify_expected_branch "$branch" "$base_sha" "$expected_diff"
  )"
  if [[ "$existing_sha" != "$commit_sha" ]]; then
    printf 'GitHub created commit %s, but branch %s resolves to %s.\n' \
      "$commit_sha" "$branch" "$existing_sha" >&2
    return 1
  fi
  printf '%s' "$commit_sha"
}

pull_request_number() {
  local branch="$1"

  gh pr list \
    --repo "$repository" \
    --state open \
    --head "$branch" \
    --json number \
    --jq '.[0].number // empty'
}

create_pull_request() {
  local branch="$1"
  local base="$2"
  local title="$3"
  local body="$4"
  local output

  created_pr=""
  if [[ "$dry_run" == "true" ]]; then
    printf 'Would create held PR %s -> %s: %s\n' "$branch" "$base" "$title"
    created_pr="0"
    return
  fi

  output="$(
    gh pr create \
      --repo "$repository" \
      --head "$branch" \
      --base "$base" \
      --title "[HOLD] ${title}" \
      --body "$body"
  )"
  printf '%s\n' "$output"
  created_pr="$(pull_request_number "$branch")"
}

update_mise_pin() {
  local current="$1"
  local candidate="$2"
  local matches

  matches="$(
    grep -c -F "min_version = \"${current}\"" "${mise_config_path}"
  )"
  if [[ "$matches" -ne 1 ]]; then
    printf 'Expected one mise pin at %s, found %s.\n' \
      "$current" "$matches" >&2
    return 1
  fi
  sed -i \
    "s/^min_version = \"${current}\"$/min_version = \"${candidate}\"/" \
    "${mise_config_path}"
}

update_hk_packages() {
  local current="$1"
  local candidate="$2"
  local matches

  matches="$(
    grep -c \
      "/jdx/hk/releases/download/v${current}/hk@${current}" \
      hk.pkl
  )"
  if [[ "$matches" -ne 2 ]]; then
    printf 'Expected two hk package pins, found %s.\n' "$matches" >&2
    return 1
  fi
  sed -i \
    "s#/jdx/hk/releases/download/v${current}/hk@${current}#/jdx/hk/releases/download/v${candidate}/hk@${candidate}#g" \
    hk.pkl
}

plan() {
  local base_sha open_prs open_count held_prs current candidate

  if [[ ! "$minimum_age_days" =~ ^[0-9]+$ ]]; then
    printf 'Release age must be a non-negative whole number.\n' >&2
    return 1
  fi

  base_sha="$(git rev-parse HEAD)"
  set_output base_sha "$base_sha"
  open_prs="$(
    gh pr list \
      --repo "$repository" \
      --state open \
      --limit 100 \
      --json number,title,url,headRefName
  )"
  open_count="$(
    jq \
      --arg prefix "$branch_prefix" \
      '[.[] |
        select(.headRefName | startswith($prefix))] |
        length' \
      <<<"$open_prs"
  )"
  if ((open_count > 0)); then
    held_prs="$(
      jq -r \
        --arg prefix "$branch_prefix" \
        '.[] |
          select(
            (.headRefName | startswith($prefix)) and
            (.title | startswith("[HOLD] "))
          ) |
          "- [#\(.number)](\(.url)): \(.title)"' \
        <<<"$open_prs"
    )"
    if [[ -n "$held_prs" ]]; then
      ensure_issue "$maintenance_issue_title" "Toolchain maintenance is paused by an update that was not made ready:

${held_prs}"
    fi
    set_output blocked true
    set_output mise_candidate ""
    return
  fi

  current="$(current_mise_version)"
  candidate="$(latest_eligible_release "jdx/mise" "$current")"
  set_output blocked false
  set_output mise_candidate "$candidate"
}

prepare_mise() {
  local candidate="${MISE_CANDIDATE:?MISE_CANDIDATE is required}"
  local base_sha="${BASE_SHA:?BASE_SHA is required}"
  local current branch existing_sha expected_diff pr body head_sha

  checkout_base "$default_branch"
  if [[ "$(git rev-parse HEAD)" != "$base_sha" ]]; then
    printf 'Default branch moved after update planning.\n' >&2
    return 1
  fi
  current="$(current_mise_version)"
  if ! version_is_greater "$candidate" "$current"; then
    printf 'Refusing mise update from %s to %s.\n' \
      "$current" "$candidate" >&2
    return 1
  fi
  update_mise_pin "$current" "$candidate"
  git diff --check
  expected_diff="$(git diff --binary)"
  if [[ -z "$expected_diff" ]]; then
    printf 'The planned mise update produced no changes.\n' >&2
    return 1
  fi

  branch="${branch_prefix}mise-${candidate}-${base_sha:0:12}"
  existing_sha="$(remote_branch_sha "$branch")"
  if [[ -n "$existing_sha" && "$existing_sha" != "$base_sha" ]]; then
    head_sha="$(verify_expected_branch "$branch" "$base_sha" "$expected_diff")"
  else
    head_sha="$(
      create_github_commit \
        "$branch" \
        "$base_sha" \
        "$expected_diff" \
        "chore: update mise to ${candidate}" \
        "${mise_config_path}"
    )"
  fi

  pr="$(pull_request_number "$branch")"
  if [[ -z "$pr" ]]; then
    body="Updates the pinned mise release after the configured ${minimum_age_days}-day waiting period.

The cross-platform \`mise run ci\` workflow must pass without warnings before this PR is made ready."
    create_pull_request \
      "$branch" \
      "$default_branch" \
      "chore: update mise to ${candidate}" \
      "$body"
    pr="$created_pr"
  fi

  set_output changed true
  set_output base_branch "$default_branch"
  set_output base_sha "$base_sha"
  set_output branch "$branch"
  set_output head_sha "$head_sha"
  set_output pr_number "$pr"
}

current_oculix_version() {
  local version

  version="$(
    sed -n 's/^version = "\([^"]*\)"$/\1/p' "${oculix_config_path}" | head -n 1
  )"
  if [[ ! "$version" =~ ^[0-9]+([.][0-9]+){1,3}$ ]]; then
    printf '%s must contain one numeric http:oculixide version.\n' \
      "${oculix_config_path}" >&2
    return 1
  fi
  printf '%s' "$version"
}

current_java_lock_version() {
  local version

  version="$(
    awk '
      $0 == "[[tools.java]]" { in_java = 1; next }
      in_java && $0 ~ /^version = "/ {
        if (match($0, /"[^"]+"/)) {
          print substr($0, RSTART + 1, RLENGTH - 2)
          exit
        }
      }
      in_java && $0 ~ /^\[\[/ { exit }
    ' "${oculix_lock_path}"
  )"
  if [[ -z "$version" ]]; then
    printf 'Failed to read java version from %s.\n' "${oculix_lock_path}" >&2
    return 1
  fi
  printf '%s' "$version"
}

configured_java_major() {
  local config_path="${1:-${oculix_config_path}}"
  local specifier

  specifier="$(
    sed -n 's/^java = "\([^"]*\)"$/\1/p' "$config_path" |
      head -n 1
  )"
  if [[ ! "$specifier" =~ ^temurin-([0-9]+)([.][0-9]+)*$ ]]; then
    printf 'Failed to read one Temurin major from %s.\n' "$config_path" >&2
    return 1
  fi
  printf '%s' "${BASH_REMATCH[1]}"
}

dominant_major() {
  awk '
    /^[0-9]+$/ {
      counts[$1] += 1
      total += 1
    }
    END {
      if (total == 0) {
        exit
      }
      top = 0
      winner = ""
      tied = 0
      for (major in counts) {
        if (counts[major] > top) {
          top = counts[major]
          winner = major
          tied = 0
        } else if (counts[major] == top) {
          tied = 1
        }
      }
      if (!tied) {
        print winner
      }
    }
  '
}

extract_java_version_evidence() {
  local path="$1"
  local line line_number=0 raw normalized major leading trimmed
  local indent block_indent=-1

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_number += 1))
    leading="${line%%[! ]*}"
    indent="${#leading}"
    trimmed="${line#"${leading}"}"
    if ((block_indent >= 0)); then
      if [[ -z "$trimmed" || "$trimmed" == \#* ]]; then
        continue
      fi
      if ((indent > block_indent)); then
        continue
      fi
      block_indent=-1
    fi
    if [[ "$line" =~ ^[[:space:]]*(-[[:space:]]+)?[[:alnum:]_.-]+[[:space:]]*:[[:space:]]*[\|\>][0-9+-]*[[:space:]]*(#.*)?$ ]]; then
      block_indent="$indent"
      continue
    fi
    if [[ ! "$line" =~ ^[[:space:]]*java-version[[:space:]]*:[[:space:]]*(.*)$ ]]; then
      continue
    fi

    raw="${BASH_REMATCH[1]}"
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    normalized=""
    if [[ "$raw" =~ ^\"([0-9]+([.][0-9]+)*)\"[[:space:]]*(#.*)?$ ]]; then
      normalized="${BASH_REMATCH[1]}"
    elif [[ "$raw" =~ ^\'([0-9]+([.][0-9]+)*)\'[[:space:]]*(#.*)?$ ]]; then
      normalized="${BASH_REMATCH[1]}"
    elif [[ "$raw" =~ ^([0-9]+([.][0-9]+)*)[[:space:]]*(#.*)?$ ]]; then
      normalized="${BASH_REMATCH[1]}"
    fi

    raw="${raw//$'\t'/ }"
    if [[ -n "$normalized" ]]; then
      major="${normalized%%.*}"
      printf 'literal\t%s\t%s\t%s\t%s\n' \
        "$path" "$line_number" "$raw" "$major"
    else
      printf 'ignored\t%s\t%s\t%s\tnon-literal or non-scalar value\n' \
        "$path" "$line_number" "$raw"
    fi
  done
}

collect_oculix_ci_java_evidence() {
  local metadata entries paths path encoded content record kind

  oculix_ci_default_branch=""
  oculix_ci_commit_sha=""
  oculix_ci_declarations=""
  oculix_ci_ignored=""

  if ! metadata="$(
    gh api \
      --method GET \
      "repos/${oculix_release_repository}"
  )"; then
    printf 'Failed to read Oculix repository metadata.\n' >&2
    return 1
  fi
  oculix_ci_default_branch="$(jq -r '.default_branch // empty' <<<"$metadata")"
  if [[ -z "$oculix_ci_default_branch" ]]; then
    printf 'Oculix repository metadata did not include a default branch.\n' >&2
    return 1
  fi

  if ! oculix_ci_commit_sha="$(
    gh api \
      --method GET \
      "repos/${oculix_release_repository}/commits/${oculix_ci_default_branch}" \
      --jq '.sha'
  )"; then
    printf 'Failed to resolve the Oculix default branch.\n' >&2
    return 1
  fi
  if [[ ! "$oculix_ci_commit_sha" =~ ^[0-9a-f]{40}$ ]]; then
    printf 'Oculix default branch did not resolve to a commit SHA.\n' >&2
    return 1
  fi

  if ! entries="$(
    gh api \
      --method GET \
      "repos/${oculix_release_repository}/contents/.github/workflows" \
      -f ref="$oculix_ci_commit_sha"
  )"; then
    printf 'Failed to list Oculix CI workflows.\n' >&2
    return 1
  fi
  if ! paths="$(
    jq -r '
      .[] |
      select(
        .type == "file" and
        (.path | test("[.]ya?ml$"))
      ) |
      .path
    ' <<<"$entries"
  )"; then
    printf 'Failed to parse the Oculix workflow listing.\n' >&2
    return 1
  fi

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    encoded="${path//\//%2F}"
    if ! content="$(
      gh api \
        --method GET \
        "repos/${oculix_release_repository}/contents/${encoded}" \
        -f ref="$oculix_ci_commit_sha" |
        jq -r '.content | gsub("\n"; "") | @base64d'
    )"; then
      printf 'Failed to read Oculix workflow %s.\n' "$path" >&2
      return 1
    fi

    while IFS= read -r record; do
      [[ -n "$record" ]] || continue
      kind="${record%%$'\t'*}"
      case "$kind" in
        literal)
          oculix_ci_declarations+="${record#*$'\t'}"$'\n'
          ;;
        ignored)
          oculix_ci_ignored+="${record#*$'\t'}"$'\n'
          ;;
      esac
    done < <(extract_java_version_evidence "$path" <<<"$content")
  done <<<"$paths"

  oculix_ci_declarations="${oculix_ci_declarations%$'\n'}"
  oculix_ci_ignored="${oculix_ci_ignored%$'\n'}"
}

oculix_ci_dominant_major() {
  local majors

  majors="$(
    if [[ -n "$oculix_ci_declarations" ]]; then
      cut -f 4 <<<"$oculix_ci_declarations"
    fi
  )"
  dominant_major <<<"$majors"
}

format_oculix_java_counts() {
  if [[ -z "$oculix_ci_declarations" ]]; then
    printf '%s' "- No literal numeric declarations found."
    return
  fi

  cut -f 4 <<<"$oculix_ci_declarations" |
    sort -n |
    uniq -c |
    awk '{ printf "- Java %s: %s declaration%s\n", $2, $1, ($1 == 1 ? "" : "s") }'
}

format_oculix_java_declarations() {
  local path line raw major link

  if [[ -z "$oculix_ci_declarations" ]]; then
    printf '%s' "- None."
    return
  fi

  while IFS=$'\t' read -r path line raw major; do
    link="https://github.com/${oculix_release_repository}/blob/${oculix_ci_commit_sha}/${path}#L${line}"
    printf -- "- \`%s:%s\` — \`%s\` → Java %s ([source](%s))\n" \
      "$path" "$line" "$raw" "$major" "$link"
  done <<<"$oculix_ci_declarations"
}

format_oculix_java_ignored() {
  local path line raw reason link

  if [[ -z "$oculix_ci_ignored" ]]; then
    printf '%s' "- None."
    return
  fi

  while IFS=$'\t' read -r path line raw reason; do
    link="https://github.com/${oculix_release_repository}/blob/${oculix_ci_commit_sha}/${path}#L${line}"
    printf -- "- \`%s:%s\` — \`%s\` (%s; [source](%s))\n" \
      "$path" "$line" "$raw" "$reason" "$link"
  done <<<"$oculix_ci_ignored"
}

watch_oculix_jdk() {
  local configured dominant disposition counts declarations ignored body
  local snapshot_url resolution resolution_marker

  configured="$(configured_java_major)"
  if ! collect_oculix_ci_java_evidence; then
    printf 'Skipping Oculix JDK drift issue changes because upstream evidence is unavailable.\n' >&2
    return
  fi
  dominant="$(oculix_ci_dominant_major)"
  counts="$(format_oculix_java_counts)"
  declarations="$(format_oculix_java_declarations)"
  ignored="$(format_oculix_java_ignored)"
  snapshot_url="https://github.com/${oculix_release_repository}/tree/${oculix_ci_commit_sha}/.github/workflows"

  if [[ -n "$dominant" && "$dominant" == "$configured" ]]; then
    resolution_marker="<!-- oculix-jdk-drift-resolved:${oculix_ci_commit_sha}:temurin-${configured}:dominant-${dominant} -->"
    resolution="${resolution_marker}
JDK major drift resolved automatically: the configured Temurin major (${configured}) matches the unique dominant Oculix CI major (${dominant}) again.

Evidence snapshot: ${snapshot_url}"
    resolve_issue "$jdk_drift_issue_title" "$resolution"
    printf 'No Oculix JDK major drift: configured %s matches dominant %s.\n' \
      "$configured" "$dominant"
    return
  fi

  if [[ -z "$dominant" ]]; then
    disposition="No unique dominant Java major could be established. Human review is required; no target major is proposed."
  else
    disposition="The unique dominant Oculix CI major is ${dominant}, which differs from configured Temurin ${configured}."
  fi

  body="Oculix CI JDK-major evidence no longer supports an automatic \"no drift\" result.

- Configured policy: \`temurin-${configured}\` in \`${oculix_config_path}\`
- Oculix default branch: \`${oculix_ci_default_branch}\`
- Immutable evidence commit: [\`${oculix_ci_commit_sha}\`](${snapshot_url})
- Result: ${disposition}

## Observed counts

${counts}

## Literal declarations

${declarations}

## Ignored declarations

${ignored}

## Manual remediation

1. Review the linked Oculix workflows and relevant release notes.
2. Decide whether this repository should adopt another Java major.
3. Intentionally update \`${oculix_config_path}\`.
4. Refresh \`${oculix_lock_path}\` for every supported platform: \`${oculix_lock_platforms}\`.
5. Run the complete policy and Oculix matrix before merging.

This automation never changes the configured Java major and never creates a pull request."

  sync_issue "$jdk_drift_issue_title" "$body"
}

update_oculix_pin() {
  local current="$1"
  local candidate="$2"
  local matches

  matches="$(grep -c -F "${current}" "${oculix_config_path}")"
  if [[ "$matches" -lt 1 ]]; then
    printf 'Expected oculix pin %s in %s, found %s matches.\n' \
      "$current" "${oculix_config_path}" "$matches" >&2
    return 1
  fi
  sed -i "s/${current}/${candidate}/g" "${oculix_config_path}"
}

refresh_oculix_lock() {
  local -a lock_args=(
    -E oculix
    lock
    --platform "${oculix_lock_platforms}"
  )

  if [[ "${1:-}" == "--bump-java" ]]; then
    lock_args+=(--bump)
  fi
  lock_args+=(java "http:oculixide")
  mise "${lock_args[@]}"
}

collect_extras_oculix_updates() {
  local current_oculix current_java bump_json new_java

  extras_oculix_summary=""
  extras_oculix_candidate=""
  extras_java_candidate=""
  current_oculix="$(current_oculix_version)"
  extras_oculix_candidate="$(
    latest_eligible_release "${oculix_release_repository}" "${current_oculix}"
  )"
  if [[ -n "$extras_oculix_candidate" ]]; then
    extras_oculix_summary+="oculix ${current_oculix} -> ${extras_oculix_candidate}"$'\n'
  fi

  current_java="$(current_java_lock_version)"
  bump_json="$(
    mise -E oculix lock \
      --bump \
      --dry-run \
      --json \
      --platform "${oculix_lock_platforms}" \
      java
  )"
  new_java="$(
    jq -r '
      [.[] | select(.name == "java") | .new_versions[0]] |
      map(select(. != null and . != "")) |
      .[0] // empty
    ' <<<"$bump_json"
  )"
  if [[ -n "$new_java" && "$new_java" != "$current_java" ]]; then
    extras_java_candidate="$new_java"
    extras_oculix_summary+="java ${current_java} -> ${new_java}"$'\n'
  fi
  extras_oculix_summary="${extras_oculix_summary%$'\n'}"
}

prepare_extras_oculix() {
  local base="${BASE_BRANCH:?BASE_BRANCH is required}"
  local base_sha="${BASE_SHA:?BASE_SHA is required}"
  local bottom_pr="${BOTTOM_PR:-}"
  local branch digest existing_sha expected_diff
  local pr body head_sha current_oculix
  local java_lock_log java_lock_status java_lock_root

  checkout_base "$base"
  if [[ "$(git rev-parse HEAD)" != "$base_sha" ]]; then
    printf 'Base branch %s moved after validation.\n' "$base" >&2
    return 1
  fi
  assert_mise_version
  collect_extras_oculix_updates
  if [[ -z "$extras_oculix_summary" ]]; then
    set_output changed false
    set_output base_branch "$base"
    set_output base_sha "$base_sha"
    set_output branch ""
    set_output head_sha ""
    set_output pr_number ""
    return
  fi

  if [[ -n "$extras_oculix_candidate" ]]; then
    current_oculix="$(current_oculix_version)"
    update_oculix_pin "$current_oculix" "$extras_oculix_candidate"
  fi
  if [[ -n "$extras_java_candidate" ]]; then
    # Dry-run bump can propose a point release whose platform metadata is
    # incomplete (e.g. no windows-x64). Capture mise output so a skipped
    # incomplete candidate does not leak WARN lines into `checked` (which
    # treats warnings as failures and opens triage).
    java_lock_root="${RUNNER_TEMP:-${HOME}/tmp}"
    mkdir -p "$java_lock_root"
    java_lock_log="$(mktemp "${java_lock_root}/java-lock.XXXXXX")"
    set +e
    refresh_oculix_lock --bump-java >"$java_lock_log" 2>&1
    java_lock_status=$?
    set -e
    if ((java_lock_status == 0)); then
      cat "$java_lock_log"
      rm -f "$java_lock_log"
    elif grep -Eq \
      'no metadata found for version|refusing to replace locked version' \
      "$java_lock_log"; then
      printf \
        'Skipping Java candidate %s: cannot lock all platforms.\n' \
        "$extras_java_candidate"
      rm -f "$java_lock_log"
      extras_java_candidate=""
      extras_oculix_summary="$(
        printf '%s\n' "$extras_oculix_summary" |
          grep -v '^java ' || true
      )"
      extras_oculix_summary="${extras_oculix_summary%$'\n'}"
      git checkout -- "${oculix_lock_path}"
      if [[ -z "$extras_oculix_summary" ]]; then
        git checkout -- "${oculix_config_path}"
        set_output changed false
        set_output base_branch "$base"
        set_output base_sha "$base_sha"
        set_output branch ""
        set_output head_sha ""
        set_output pr_number ""
        return
      fi
      refresh_oculix_lock
    else
      cat "$java_lock_log" >&2
      rm -f "$java_lock_log"
      return "$java_lock_status"
    fi
  else
    refresh_oculix_lock
  fi

  git diff --check
  expected_diff="$(git diff --binary)"
  if [[ -z "$expected_diff" ]]; then
    printf 'The planned extras/oculix update produced no changes.\n' >&2
    return 1
  fi

  digest="$(
    printf '%s\n%s\n%s' "$base" "$base_sha" "$extras_oculix_summary" |
      sha256sum |
      cut -c 1-12
  )"
  branch="${branch_prefix}extras-oculix-${digest}"
  existing_sha="$(remote_branch_sha "$branch")"
  if [[ -n "$existing_sha" && "$existing_sha" != "$base_sha" ]]; then
    head_sha="$(verify_expected_branch "$branch" "$base_sha" "$expected_diff")"
  else
    head_sha="$(
      create_github_commit \
        "$branch" \
        "$base_sha" \
        "$expected_diff" \
        "chore: update oculix extras pins" \
        "${oculix_config_path}" \
        "${oculix_lock_path}"
    )"
  fi

  pr="$(pull_request_number "$branch")"
  if [[ -z "$pr" ]]; then
    body="Updates the oculix extras lane (Oculix stable release and/or Java point lock) after the configured ${minimum_age_days}-day waiting period for Oculix.

\`\`\`
${extras_oculix_summary}
\`\`\`

Stacked after tools as a parallel extras leaf. Cross-platform validation must pass before this PR is made ready."
    create_pull_request \
      "$branch" \
      "$base" \
      "chore: update oculix extras pins" \
      "$body"
    pr="$created_pr"
  fi

  if [[ -n "$bottom_pr" && "$dry_run" != "true" ]]; then
    jq -n \
      --argjson bottom "$bottom_pr" \
      --argjson top "$pr" \
      '{pull_requests: [$bottom, $top]}' |
      gh api \
        --method POST \
        -H "X-GitHub-Api-Version: 2026-03-10" \
        "repos/${repository}/stacks" \
        --input - >/dev/null
  fi
  set_output changed true
  set_output base_branch "$base"
  set_output base_sha "$base_sha"
  set_output branch "$branch"
  set_output head_sha "$head_sha"
  set_output pr_number "$pr"
}

prepare_tools() {
  local base="${BASE_BRANCH:?BASE_BRANCH is required}"
  local base_sha="${BASE_SHA:?BASE_SHA is required}"
  local bottom_pr="${BOTTOM_PR:-}"
  local branch digest existing_sha expected_diff
  local pr body tool current candidate head_sha

  checkout_base "$base"
  if [[ "$(git rev-parse HEAD)" != "$base_sha" ]]; then
    printf 'Base branch %s moved after validation.\n' "$base" >&2
    return 1
  fi
  assert_mise_version
  collect_tool_updates
  if [[ -z "$tool_updates" ]]; then
    set_output changed false
    set_output base_branch "$base"
    set_output base_sha "$base_sha"
    set_output branch ""
    set_output head_sha ""
    set_output pr_number ""
    return
  fi

  digest="$(
    printf '%s\n%s\n%s' "$base" "$base_sha" "$tool_updates" |
      sha256sum |
      cut -c 1-12
  )"
  branch="${branch_prefix}tools-${digest}"
  while IFS=$'\t' read -r tool current candidate; do
    mise config set \
      --file "${mise_config_path}" \
      --type string \
      "tools.${tool}" \
      "$candidate"
    if [[ "$tool" == "hk" ]]; then
      update_hk_packages "$current" "$candidate"
    fi
  done <<<"$tool_updates"
  mise lock
  git diff --check
  expected_diff="$(git diff --binary)"
  if [[ -z "$expected_diff" ]]; then
    printf 'The planned tool updates produced no changes.\n' >&2
    return 1
  fi

  existing_sha="$(remote_branch_sha "$branch")"
  if [[ -n "$existing_sha" && "$existing_sha" != "$base_sha" ]]; then
    head_sha="$(verify_expected_branch "$branch" "$base_sha" "$expected_diff")"
  else
    head_sha="$(
      create_github_commit \
        "$branch" \
        "$base_sha" \
        "$expected_diff" \
        "chore: update pinned tools" \
        "${mise_config_path}" \
        "${mise_lock_path}" \
        hk.pkl
    )"
  fi

  pr="$(pull_request_number "$branch")"
  if [[ -z "$pr" ]]; then
    body="Updates eligible tool pins after the configured ${minimum_age_days}-day waiting period.

The cross-platform \`mise run ci\` workflow must pass without warnings before this PR is made ready."
    create_pull_request \
      "$branch" \
      "$base" \
      "chore: update pinned tools" \
      "$body"
    pr="$created_pr"
  fi

  if [[ -n "$bottom_pr" && "$dry_run" != "true" ]]; then
    jq -n \
      --argjson bottom "$bottom_pr" \
      --argjson top "$pr" \
      '{pull_requests: [$bottom, $top]}' |
      gh api \
        --method POST \
        -H "X-GitHub-Api-Version: 2026-03-10" \
        "repos/${repository}/stacks" \
        --input - >/dev/null
  fi
  set_output changed true
  set_output base_branch "$base"
  set_output base_sha "$base_sha"
  set_output branch "$branch"
  set_output head_sha "$head_sha"
  set_output pr_number "$pr"
}

post_commit_status() {
  local head_sha="$1"
  local state="$2"
  local description="$3"

  gh api \
    --silent \
    --method POST \
    "repos/${repository}/statuses/${head_sha}" \
    -f state="$state" \
    -f context="toolchain-maintenance / cross-platform" \
    -f description="$description" \
    -f target_url="${GITHUB_SERVER_URL}/${repository}/actions/runs/${GITHUB_RUN_ID}" \
    2>&1
}

fail_readiness() {
  local pr="$1"
  local head_sha="$2"
  local original_title="$3"
  local restore_title="$4"
  local reason="$5"
  local details="$6"
  local rollback_output="" rollback_warnings="" status_output="" body

  if [[ "$restore_title" == "true" ]]; then
    if ! rollback_output="$(
      gh pr edit \
        "$pr" \
        --repo "$repository" \
        --title "$original_title" \
        2>&1
    )"; then
      details+=$'\n\nFailed to restore the held PR title:\n'"${rollback_output}"
    else
      rollback_warnings="$(find_warnings <<<"$rollback_output")"
      if [[ -n "$rollback_warnings" ]]; then
        details+=$'\n\nWarnings while restoring the held PR title:\n'"${rollback_warnings}"
      fi
    fi
  fi

  if ! status_output="$(
    post_commit_status \
      "$head_sha" \
      failure \
      "Readiness failed; triage the maintenance run"
  )"; then
    details+=$'\n\nFailed to record the failure status:\n'"${status_output}"
  fi

  body="${reason}

Run: ${GITHUB_SERVER_URL}/${repository}/actions/runs/${GITHUB_RUN_ID}"
  if [[ -n "$details" ]]; then
    body+=$'\n\nDetails:\n'"${details}"
  fi
  upsert_issue "$maintenance_issue_title" "$body"
  return 1
}

mark_ready() {
  local pr="${PR_NUMBER:?PR_NUMBER is required}"
  local head_sha="${HEAD_SHA:?HEAD_SHA is required}"
  local head_branch="${HEAD_BRANCH:?HEAD_BRANCH is required}"
  local expected_base_sha="${EXPECTED_BASE_SHA:?EXPECTED_BASE_SHA is required}"
  local expected_base_branch="${EXPECTED_BASE_BRANCH:?EXPECTED_BASE_BRANCH is required}"
  local data title pr_head_sha pr_head_branch pr_base_sha pr_base_branch
  local audit_output audit_warnings view_warnings
  local status_output status_warnings ready_output ready_warnings

  if [[ "$dry_run" == "true" ]]; then
    printf 'Would mark PR #%s ready.\n' "$pr"
    return
  fi

  if ! audit_output="$(report_run 2>&1)"; then
    printf '%s\n' "$audit_output" >&2
    return 1
  fi
  audit_warnings="$(find_warnings <<<"$audit_output")"
  if [[ -n "$audit_warnings" ]]; then
    printf '%s\nWarnings are treated as failures.\n' \
      "$audit_warnings" >&2
    return 1
  fi

  if ! data="$(
    gh pr view \
      "$pr" \
      --repo "$repository" \
      --json title,headRefName,headRefOid,baseRefName,baseRefOid \
      2>&1
  )"; then
    printf '%s\n' "$data" >&2
    return 1
  fi
  view_warnings="$(find_warnings <<<"$data")"
  if [[ -n "$view_warnings" ]]; then
    printf '%s\nWarnings are treated as failures.\n' \
      "$view_warnings" >&2
    return 1
  fi

  title="$(jq -r '.title' <<<"$data")"
  pr_head_sha="$(jq -r '.headRefOid' <<<"$data")"
  pr_head_branch="$(jq -r '.headRefName' <<<"$data")"
  pr_base_sha="$(jq -r '.baseRefOid' <<<"$data")"
  pr_base_branch="$(jq -r '.baseRefName' <<<"$data")"
  if [[ "$pr_head_sha" != "$head_sha" ||
        "$pr_head_branch" != "$head_branch" ]]; then
    printf 'Validation no longer matches the current PR head.\n' >&2
    return 1
  fi
  if [[ "$pr_base_sha" != "$expected_base_sha" ||
        "$pr_base_branch" != "$expected_base_branch" ]]; then
    printf 'Validation no longer matches the current PR base.\n' >&2
    return 1
  fi

  if ! status_output="$(
    post_commit_status \
      "$head_sha" \
      success \
      "Ubuntu, macOS, and Windows passed without warnings"
  )"; then
    fail_readiness \
      "$pr" "$head_sha" "$title" false \
      "Failed to record successful validation." \
      "$status_output" || return 1
  fi
  status_warnings="$(find_warnings <<<"$status_output")"
  if [[ -n "$status_warnings" ]]; then
    fail_readiness \
      "$pr" "$head_sha" "$title" false \
      "A command warned while recording successful validation." \
      "$status_warnings" || return 1
  fi

  if [[ "$title" == "[HOLD] "* ]]; then
    if ! ready_output="$(
      gh pr edit \
        "$pr" \
        --repo "$repository" \
        --title "${title#"[HOLD] "}" \
        2>&1
    )"; then
      fail_readiness \
        "$pr" "$head_sha" "$title" true \
        "Failed to remove the toolchain maintenance hold." \
        "$ready_output" || return 1
    fi
    ready_warnings="$(find_warnings <<<"$ready_output")"
    if [[ -n "$ready_warnings" ]]; then
      fail_readiness \
        "$pr" "$head_sha" "$title" true \
        "A command warned while removing the toolchain maintenance hold." \
        "$ready_warnings" || return 1
    fi
  fi
}

triage_issue_number() {
  local title="$1"

  gh issue list \
    --repo "$repository" \
    --state open \
    --limit 100 \
    --search "\"${title}\" in:title" \
    --json number,title \
    --jq '.[] | [.number, .title] | @tsv' |
    awk -F '\t' -v title="$title" '$2 == title { print $1; exit }'
}

ensure_issue() {
  local title="$1"
  local body="$2"
  local existing

  if [[ "$dry_run" == "true" ]]; then
    printf 'Would ensure issue exists: %s\n%s\n' "$title" "$body"
    return
  fi

  existing="$(triage_issue_number "$title")"
  if [[ -z "$existing" ]]; then
    gh issue create \
      --repo "$repository" \
      --title "$title" \
      --body "$body"
  fi
}

upsert_issue() {
  local title="$1"
  local body="$2"
  local existing

  if [[ "$dry_run" == "true" ]]; then
    printf 'Would report issue update: %s\n%s\n' "$title" "$body"
    return
  fi

  existing="$(triage_issue_number "$title")"
  if [[ -n "$existing" ]]; then
    gh issue comment "$existing" --repo "$repository" --body "$body"
  else
    gh issue create \
      --repo "$repository" \
      --title "$title" \
      --body "$body"
  fi
}

sync_issue() {
  local title="$1"
  local body="$2"
  local existing

  if [[ "$dry_run" == "true" ]]; then
    printf 'Would synchronize generated issue: %s\n%s\n' "$title" "$body"
    return
  fi

  existing="$(triage_issue_number "$title")"
  if [[ -n "$existing" ]]; then
    gh issue edit "$existing" \
      --repo "$repository" \
      --title "$title" \
      --body "$body"
  else
    gh issue create \
      --repo "$repository" \
      --title "$title" \
      --body "$body"
  fi
}

resolve_issue() {
  local title="$1"
  local body="$2"
  local existing marker comments

  if [[ "$dry_run" == "true" ]]; then
    printf 'Would resolve generated issue if open: %s\n%s\n' "$title" "$body"
    return
  fi

  existing="$(triage_issue_number "$title")"
  if [[ -z "$existing" ]]; then
    return
  fi
  marker="${body%%$'\n'*}"
  comments=""
  if [[ "$marker" == '<!-- '* ]]; then
    comments="$(
      gh issue view "$existing" \
        --repo "$repository" \
        --json comments \
        --jq '.comments[].body'
    )"
  fi
  if [[ "$marker" != '<!-- '* ]] ||
    ! grep -Fq -- "$marker" <<<"$comments"; then
    gh issue comment "$existing" --repo "$repository" --body "$body"
  fi
  gh issue close "$existing" --repo "$repository" --reason completed
}

report_run() {
  local jobs failures="" warning_lines="" check_urls check_url
  local annotations found body

  if ! jobs="$(
    gh api \
      --method GET \
      "repos/${repository}/actions/runs/${GITHUB_RUN_ID}/jobs" \
      -f per_page=100
  )"; then
    body="Failed to inspect jobs for run ${GITHUB_RUN_ID}.

Run: ${GITHUB_SERVER_URL}/${repository}/actions/runs/${GITHUB_RUN_ID}"
    upsert_issue "$maintenance_issue_title" "$body"
    return 1
  fi
  if ! failures="$(
    jq -r \
      '.jobs[] |
        select(
          .conclusion != null and
          .conclusion != "success" and
          .conclusion != "skipped"
        ) |
        "- \(.name): \(.conclusion)"' \
      <<<"$jobs"
  )"; then
    printf 'Failed to parse jobs for run %s.\n' "$GITHUB_RUN_ID" >&2
    return 1
  fi
  if ! check_urls="$(
    jq -r '.jobs[].check_run_url' <<<"$jobs"
  )"; then
    printf 'Failed to parse check runs for run %s.\n' \
      "$GITHUB_RUN_ID" >&2
    return 1
  fi

  while [[ -n "$check_urls" ]] && IFS= read -r check_url; do
    if ! annotations="$(
      gh api \
        --method GET \
        --paginate \
        --slurp \
        "${check_url}/annotations" \
        -f per_page=100
    )"; then
      body="Failed to inspect annotations for run ${GITHUB_RUN_ID}.

Run: ${GITHUB_SERVER_URL}/${repository}/actions/runs/${GITHUB_RUN_ID}"
      upsert_issue "$maintenance_issue_title" "$body"
      return 1
    fi
    if ! found="$(
      jq -r \
        '.[][] |
          select(.annotation_level == "warning") |
          "- \(.path // "workflow"): \(.message)"' \
        <<<"$annotations"
    )"; then
      printf 'Failed to parse annotations for run %s.\n' \
        "$GITHUB_RUN_ID" >&2
      return 1
    fi
    if [[ -n "$found" ]]; then
      warning_lines+="${warning_lines:+$'\n'}${found}"
    fi
  done <<<"$check_urls"

  if [[ -z "$failures" && -z "$warning_lines" ]]; then
    return
  fi

  body="Run: ${GITHUB_SERVER_URL}/${repository}/actions/runs/${GITHUB_RUN_ID}"
  if [[ -n "$failures" ]]; then
    body+=$'\n\nFailed jobs:\n'"${failures}"
  fi
  if [[ -n "$warning_lines" ]]; then
    body+=$'\n\nWarnings:\n'"${warning_lines}"
  fi
  upsert_issue "$maintenance_issue_title" "$body"
  return 1
}

checked() {
  local temp_root log status tee_status warning_lines
  local -a pipe_status

  temp_root="${RUNNER_TEMP:-${HOME}/tmp}"
  mkdir -p "$temp_root"
  log="$(mktemp "${temp_root}/toolchain-maintenance.XXXXXX")"

  set +e
  "$0" "$@" 2>&1 | tee "$log"
  pipe_status=("${PIPESTATUS[@]}")
  status="${pipe_status[0]}"
  tee_status="${pipe_status[1]}"
  set -e
  if ((status != 0)); then
    rm -f "$log"
    return "$status"
  fi
  if ((tee_status != 0)); then
    rm -f "$log"
    printf 'Failed to capture command output.\n' >&2
    return "$tee_status"
  fi

  warning_lines="$(find_warnings <"$log")"
  rm -f "$log"
  if [[ -n "$warning_lines" ]]; then
    printf '%s\nWarnings are treated as failures.\n' "$warning_lines" >&2
    return 1
  fi
}

load_default_branch() {
  default_branch="$(gh api "repos/${repository}" --jq '.default_branch')"
  if [[ -z "$default_branch" ]]; then
    printf 'Failed to read the repository default branch.\n' >&2
    return 1
  fi
}

main() {
  if [[ -z "$repository" ]]; then
    printf 'GITHUB_REPOSITORY is required.\n' >&2
    return 2
  fi

  case "${1:-}" in
    checked)
      shift
      checked "$@"
      ;;
    plan)
      plan
      ;;
    prepare-mise)
      load_default_branch
      prepare_mise
      ;;
    prepare-tools)
      prepare_tools
      ;;
    prepare-extras-oculix)
      prepare_extras_oculix
      ;;
    watch-oculix-jdk)
      watch_oculix_jdk
      ;;
    ready)
      mark_ready
      ;;
    report-run)
      report_run
      ;;
    *)
      printf 'Unknown toolchain maintenance command: %s\n' "${1:-}" >&2
      return 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
