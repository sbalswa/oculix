#!/usr/bin/env bash
#MISE description="Run an Oculix script"
#MISE alias="oculix"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:?MISE_PROJECT_ROOT is required}"

script="${1:-tests/e2e/oculix/basic.sikuli}"
oculix_directory="$(mise where http:oculixide)"
set -- "${oculix_directory}"/*.jar

if [[ "$#" -ne 1 || ! -f "$1" ]]; then
  printf 'Expected exactly one Oculix jar in %s.\n' "$oculix_directory" >&2
  exit 1
fi

temporary_directory="${RUNNER_TEMP:-$HOME/tmp}/oculix"
mkdir -p "$temporary_directory"
export TMPDIR="$temporary_directory"
java_arguments=("-Djava.io.tmpdir=$temporary_directory")

if [[ "$(uname -s)" == "Darwin" ]]; then
  # Oculix v4.0.0 bundles versioned dylibs; Tess4J expects unversioned names.
  native_root="$temporary_directory/natives"
  native_directory="$native_root/darwin-aarch64"
  mkdir -p "$native_root"
  (
    cd "$native_root"
    jar xf "$1" \
      darwin-aarch64/libleptonica.6.dylib \
      darwin-aarch64/libtesseract.5.dylib
    cd "$native_directory"
    leptonica_dependency="$(
      otool -L libtesseract.5.dylib |
        awk '/libleptonica[.]6[.]dylib/ { print $1; exit }'
    )"
    if [[ -z "$leptonica_dependency" ]]; then
      printf 'Bundled libtesseract has no libleptonica dependency.\n' >&2
      exit 1
    fi
    if [[ "$leptonica_dependency" != "@loader_path/libleptonica.6.dylib" ]]; then
      install_name_tool \
        -change "$leptonica_dependency" \
        "@loader_path/libleptonica.6.dylib" \
        libtesseract.5.dylib
      codesign --force --sign - libtesseract.5.dylib
    fi
    ln -sfn libleptonica.6.dylib libleptonica.dylib
    ln -sfn libtesseract.5.dylib libtesseract.dylib
  )
  java_arguments+=("-Djna.library.path=$native_directory")
fi

exec java "${java_arguments[@]}" -jar "$1" -c -r "$script"
